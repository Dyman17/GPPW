# Runtime
NODE_ENV=development
WEBSITE_URL=http://localhost:4200
# Optional explicit Better Auth base URL; Render falls back to RENDER_EXTERNAL_URL.
BETTER_AUTH_URL=http://localhost:4200
WEBSITE_PORT=4200

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL — use the Render internal connection string in production
DATABASE_URL=
