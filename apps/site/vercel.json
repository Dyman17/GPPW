{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"buildCommand": "cd ../.. && bun install --frozen-lockfile && bun run build:site",
	"outputDirectory": "dist",
	"rewrites": [
		{ "source": "/api/(.*)", "destination": "/api" },
		{ "source": "/(.*)", "destination": "/index.html" }
	]
}
