{
  "name": "gppw",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@gppw/site",
    "build": "turbo build",
    "build:site": "turbo build --filter=@gppw/site",
    "typecheck": "turbo typecheck",
    "test:api": "turbo run test:api --filter=@gppw/site",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  }
}
